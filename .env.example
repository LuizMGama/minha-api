# Copie para .env e substitua os placeholders antes de executar.
PORT=3001
MONGODB_NAME=biblioteca_jogos
MONGO_INITDB_ROOT_USERNAME=usuario_local
MONGO_INITDB_ROOT_PASSWORD=SUBSTITUA_POR_SENHA_MONGO
# Use o mesmo usuário e senha acima; codifique caracteres especiais na URI.
MONGODB_URI=mongodb://usuario_local:SUBSTITUA_POR_SENHA_MONGO@127.0.0.1:27018/?authSource=admin
JWT_SECRET=SUBSTITUA_POR_SEGREDO_JWT_LONGO_E_ALEATORIO
JWT_EXPIRES_IN=1d

# Conta fixa: teste@exemplo.com. Forneça a senha separadamente ao professor.
DEMO_PASSWORD=SUBSTITUA_POR_SENHA_DEMONSTRATIVA
DEMO_SECURITY_QUESTION=Qual foi seu primeiro jogo?
DEMO_SECURITY_ANSWER=SUBSTITUA_POR_RESPOSTA_FICTICIA
